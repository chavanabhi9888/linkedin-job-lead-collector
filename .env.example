# ---------- Application ----------
APP_ENV=production
LOG_LEVEL=INFO
LOG_JSON=true
# Leave empty to disable API auth (NOT recommended outside localhost).
API_KEY=change-me-to-a-long-random-string

# ---------- Database ----------
# Used by docker-compose for the postgres container
POSTGRES_USER=leads
POSTGRES_PASSWORD=change-me
POSTGRES_DB=leads
# Used by the app (docker-compose overrides the host with "db")
DATABASE_URL=postgresql+psycopg://leads:change-me@localhost:5432/leads

# ---------- Lead source ----------
# linkedin  -> Playwright browser source (see README compliance notes)
# json_file -> read posts from a JSON file (approved exports / demos / tests)
LEAD_SOURCE=linkedin
JSON_SOURCE_PATH=data/sample_posts.json

# ---------- LinkedIn (normal login flow only) ----------
# Preferred: run `python -m app.cli login` once; it saves a session file and you
# complete any CAPTCHA/MFA yourself. Credentials below are only a fallback and
# can never get past CAPTCHA/MFA (the job stops with NEEDS_MANUAL_ACTION).
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=
LINKEDIN_STORAGE_STATE=data/linkedin_state.json

# ---------- Browser / politeness ----------
BROWSER_HEADLESS=true
NAV_TIMEOUT_MS=30000
MIN_ACTION_DELAY_S=3
MAX_ACTION_DELAY_S=7
MAX_SCROLLS=8
MAX_RETRIES=3
SCREENSHOT_DIR=data/screenshots

# ---------- Defaults for scheduled / unspecified runs ----------
DEFAULT_KEYWORD=Python Developer
DEFAULT_LOCATION=Pune, India
DEFAULT_TIME_FILTER=past_24h
DEFAULT_MAX_POSTS=50

# ---------- Scheduler (APScheduler, runs inside the API process) ----------
SCHEDULER_ENABLED=false
SCHEDULER_CRON=0 9 * * *
SCHEDULER_TIMEZONE=Asia/Kolkata

# ---------- Exports ----------
EXPORT_DIR=exports
